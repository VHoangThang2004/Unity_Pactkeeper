  m_Script: {fileID: 11500000, guid: 124c44d0ff441b24d9ea9691b2ad7fa8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Client::ReportTabManager
  panel: {fileID: 2011965619}
  closeButton: {fileID: 0}
  termsOfServiceButton: {fileID: 1968662172}
  privacyPolicyButton: {fileID: 287603890}
  antiCheatPolicyButton: {fileID: 141332547}
  reportBugButton: {fileID: 1069103310}
  reportPlayerButton: {fileID: 1080815215}
  contentPanel: {fileID: 748565764}
  contentTitleText: {fileID: 1283676044}
  contentBodyText: {fileID: 1989000909}
  closeContentButton: {fileID: 589366320}
  termsOfServiceContent: "Pactkeeper \u2014 Terms of Service\n\nBy playing Pactkeeper,
    you agree to the following:\n\n\u2022 Do not use cheats, hacks, or exploits.\n\u2022
    Do not modify or interfere with client or game files.\n\u2022 Do not use third-party
    software to gain an unfair advantage.\n\u2022 Do not exploit bugs for personal
    gain.\n\u2022 Do not intentionally abuse matchmaking, gacha, ranking, or inventory
    systems.\n\u2022 Do not impersonate or hijack another player's account.\n\u2022
    Do not engage in fraudulent behavior during PvP.\n\u2022 Do not intentionally
    disconnect or abuse disconnect-detection systems.\n\u2022 Do not spam or abuse
    the Report feature.\n\nPactkeeper reserves the right to investigate suspected
    violations and take appropriate action against accounts that violate these rules,
    up to and including permanent suspension."
  privacyPolicyContent: "Pactkeeper \u2014 Privacy Policy\n\nWe collect and store
    the following data to operate the game:\n\nAccount & Identity\n\u2022 Account
    ID, Username, Email address\n\u2022 Google linked ID (if applicable)\n\nSession
    & Network\n\u2022 IP address and login timestamps\n\u2022 Device information
    (OS, hardware model)\n\nGameplay\n\u2022 Match history and results\n\u2022 Ranking
    and progression data\n\u2022 Gacha and inventory records\n\nModeration\n\u2022
    Report history (submitted and received)\n\u2022 Anti-cheat logs and detected
    anomalies\n\nYour data is used solely to operate, maintain, and improve Pactkeeper.
    We do not sell your personal information to third parties. Data may be retained
    for moderation purposes after account deletion."
  antiCheatPolicyContent: "Pactkeeper \u2014 Fair Play & Anti-Cheat Policy\n\nProhibited
    Behaviors\n\nCheating\nSpeed hacks, damage modification, or any client-side manipulation.\n\nExploiting\nIntentionally
    triggering known bugs for personal gain.\n\nUnauthorized Software\nAny tool that
    reads, writes, or interferes with game memory or network traffic.\n\nAccount
    Abuse\nSharing, selling, or hijacking accounts.\n\nMatch Manipulation\nIntentionally
    throwing matches or colluding with opponents.\n\nRanking Abuse\nExploiting bugs
    or loopholes to gain ranking points unfairly.\n\nReport Abuse\nSubmitting false
    or mass reports against innocent players.\n\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nEnforcement\n\nMinor
    violation\n\u2192 Written warning\n\nRepeated violation\n\u2192 Temporary suspension\n\nSerious
    cheating / hack\n\u2192 Permanent ban\n\nCompetitive / ranking abuse\n\u2192
    Ranking points removed, match results invalidated, temporary ban"
