%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d56cce9b854dbe4eb4d220d3699184f, type: 3}
  m_Name: Plot_C0_S1
  m_EditorClassIdentifier: Client::PlotConfig
  chapterId: 0
  sceneId: 1
  nodes:
  - type: 4
    text: 
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 2
    targetWaitTimeout: 10
  - type: 0
    text: Welcome to the proving grounds, Pactkeeper. I am Commander Reinhardt. Use
      W, A, S, D and the mouse wheel to survey the arena.
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 0
    text: Eyes on the Ready Bar at the top. Your Assassin has reached Step 0 and
      awaits your command.
    tutorialTargetId: OwnedReadyBar
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Select your Assassin.
    tutorialTargetId: Unit1
    targetCell: {x: 0, y: 0}
    delay: 0.5
    targetWaitTimeout: 10
  - type: 0
    text: Notice that glowing Eye symbol? Real time has come to a halt. While the
      Eye remains open, the battlefield bends to your will.
    tutorialTargetId: YourEye
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 3
    text: Advance your Assassin into an L-shaped flanking stance at (0, -1). Never
      leave yourself exposed.
    tutorialTargetId: 
    targetCell: {x: 0, y: -1}
    delay: 0.5
    targetWaitTimeout: 10
  - type: 1
    text: Confirm your movement.
    tutorialTargetId: ConfirmButton
    targetCell: {x: 0, y: 0}
    delay: 1.5
    targetWaitTimeout: 10
  - type: 1
    text: Clean footwork. Movement is an Instant action, so your turn is still active.
      Press Wait - those who bide their time survive.
    tutorialTargetId: WaitButton
    targetCell: {x: 0, y: 0}
    delay: 1
    targetWaitTimeout: 10
  - type: 4
    text: 
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 7
    targetWaitTimeout: 15
  - type: 0
    text: I intentionally yielded my turn as well. Only a fool lunges blindly when
      the quarry stands out of reach.
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Select your Assassin once more.
    tutorialTargetId: Unit1
    targetCell: {x: 0, y: 0}
    delay: 0.5
    targetWaitTimeout: 10
  - type: 2
    text: Blades do not swing themselves. Right-click your Weapon Skill to inspect
      its reach.
    tutorialTargetId: WSKILL
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 0
    text: "Study the Inspect panel carefully - range, SP cost, and damage. Never
      swing steel at thin air."
    tutorialTargetId: InspectPanel
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Close the Inspect panel.
    tutorialTargetId: CancelButton
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: The distance is still too wide. Press Wait and let your enemy walk into
      the trap.
    tutorialTargetId: WaitButton
    targetCell: {x: 0, y: 0}
    delay: 1.5
    targetWaitTimeout: 10
  - type: 5
    text: Discipline before bloodshed. That concludes your first lesson, Pactkeeper.
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
