  m_Script: {fileID: 11500000, guid: 2d56cce9b854dbe4eb4d220d3699184f, type: 3}
  m_Name: Plot_C0_S2
  m_EditorClassIdentifier: Client::PlotConfig
  chapterId: 0
  sceneId: 2
  nodes:
  - type: 4
    text: 
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 2
    targetWaitTimeout: 10
  - type: 0
    text: Welcome back. I have deployed a heavy vanguard alongside your Assassin.
      True commanders fight as a unit.
    tutorialTargetId: OwnedReadyBar
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Select your Paladin from the Ready Bar.
    tutorialTargetId: Unit2
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 3
    text: March him forward into striking position at (0, 1).
    tutorialTargetId: 
    targetCell: {x: 0, y: 1}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Confirm movement.
    tutorialTargetId: ConfirmButton
    targetCell: {x: 0, y: 0}
    delay: 2.5
    targetWaitTimeout: 10
  - type: 1
    text: Movement is Instant - he can still act. Select the Paladin again.
    tutorialTargetId: Unit2
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 6
    text: Prepare to heave that heavy axe. Left-click his Weapon Skill.
    tutorialTargetId: WSKILL
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 3
    text: Aim directly at the enemy tile (1, 0).
    tutorialTargetId: 
    targetCell: {x: 1, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Commit the strike.
    tutorialTargetId: ConfirmButton
    targetCell: {x: 0, y: 0}
    delay: 1.5
    targetWaitTimeout: 10
  - type: 0
    text: Notice that? The command is locked in, yet no blow has fallen. Let us inspect
      why.
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 3
    text: Click the Paladin on the board at (0, 1) to view his loadout.
    tutorialTargetId: 
    targetCell: {x: 0, y: 1}
    delay: 0
    targetWaitTimeout: 10
  - type: 2
    text: Right-click his Weapon Skill to inspect its timing.
    tutorialTargetId: WSKILL
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 0
    text: Look closely at the Skill Type - every weapon strike is Non-Instant (Delayed).
    tutorialTargetId: STYPE
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 0
    text: Heavy steel takes momentum. All Non-Instant strikes unleash together at
      the end of the Paused Instant, ordered by Speed.
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Close the Inspect panel.
    tutorialTargetId: CancelButton
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Press Wait to close the Instant and watch the delayed cleave crash down!
    tutorialTargetId: WaitButton
    targetCell: {x: 0, y: 0}
    delay: 3.5
    targetWaitTimeout: 10
  - type: 5
    text: Well struck. Master the delay between intention and impact, and no foe
      can evade you.
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
