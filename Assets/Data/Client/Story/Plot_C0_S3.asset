  - type: 0
    text: Both warriors stand ready, and your Assassin has gathered Skill Points
      (SP). Time to finish this duel!
    tutorialTargetId: 
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Select your Assassin first.
    tutorialTargetId: Unit1
    targetCell: {x: 0, y: 0}
    delay: 0
    targetWaitTimeout: 10
  - type: 3
    text: Leap forward to (0, -1) to close the gap.
