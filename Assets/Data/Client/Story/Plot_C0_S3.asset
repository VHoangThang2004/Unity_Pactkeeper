    targetCell: {x: 0, y: -1}
    delay: 0
    targetWaitTimeout: 10
  - type: 1
    text: Confirm your first bound.
    tutorialTargetId: ConfirmButton
    targetCell: {x: 0, y: 0}
    delay: 2.5
    targetWaitTimeout: 10
  - type: 1
    text: A unit can normally move only once per Instant - unless it shatters its
